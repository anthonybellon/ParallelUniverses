# Copy this file to .env.local and fill in the values.

# Optional. The app's own key. Without it, people can still add their own
# key in the app (the "AI" button in the header), or write events themselves.
# A user's own key is used instead of this one when they set it.
OPENAI_API_KEY=

# Optional. The OpenAI chat model to use. Defaults to gpt-4o-mini.
OPENAI_MODEL=
